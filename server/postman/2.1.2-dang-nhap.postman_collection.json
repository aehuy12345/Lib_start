{
  "info": {
    "name": "Lib_start - 2.1.2 Đăng nhập",
    "description": "API test cho tính năng 2.1.2 Đăng nhập (design/flows/2.1.2-dang-nhap.md). Cần chạy `node scripts/seed-test-users.js` trước để có tài khoản test (mật khẩu chung Test@1234). Chạy theo thứ tự: các request Happy case lưu token cho phần Phiên đăng nhập.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "password", "value": "Test@1234" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('rlEmail')) {",
          "  pm.collectionVariables.set('rlEmail', `pm-rl+${Date.now()}@example.com`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Happy case",
      "item": [
        {
          "name": "Reader đăng nhập (email hoa + khoảng trắng) → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('có token JWT', () => pm.expect(b.token).to.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
            "pm.test('user reader, active, không lộ passwordHash', () => { pm.expect(b.user.role).to.eql('reader'); pm.expect(b.user.status).to.eql('active'); pm.expect(b.user).to.not.have.property('passwordHash'); });",
            "pm.test('token hạn 24h, chứa userId và role', () => {",
            "  const p = JSON.parse(atob(b.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
            "  pm.expect(p.exp - p.iat).to.eql(86400); pm.expect(p.sub).to.eql(String(b.user.id)); pm.expect(p.role).to.eql('reader');",
            "});",
            "pm.collectionVariables.set('readerToken', b.token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"  TEST.Reader@Example.com \",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Librarian đăng nhập → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('role librarian', () => pm.expect(pm.response.json().user.role).to.eql('librarian'));",
            "pm.collectionVariables.set('librarianToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"test.librarian@example.com\",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Admin đăng nhập → 200",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('role admin', () => pm.expect(pm.response.json().user.role).to.eql('admin'));",
            "pm.collectionVariables.set('adminToken', pm.response.json().token);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"test.admin@example.com\",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Business rules",
      "item": [
        {
          "name": "Sai mật khẩu → 401 thông báo chung",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('thông báo chung', () => pm.expect(pm.response.json().message).to.eql('Email hoặc mật khẩu không đúng'));",
            "pm.test('không trả token', () => pm.expect(pm.response.json()).to.not.have.property('token'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"test.reader@example.com\",\"password\":\"WrongPass1\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Edge 1: email không tồn tại → cùng 401 thông báo chung",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('thông báo giống sai mật khẩu', () => pm.expect(pm.response.json().message).to.eql('Email hoặc mật khẩu không đúng'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"nobody-{{$timestamp}}@example.com\",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Tài khoản chờ xác nhận → 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));",
            "pm.test('thông báo chưa xác nhận', () => pm.expect(pm.response.json().message).to.eql('Tài khoản chưa được xác nhận'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"test.pending@example.com\",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Tài khoản vô hiệu hóa → 403",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403', () => pm.response.to.have.status(403));",
            "pm.test('thông báo vô hiệu hóa', () => pm.expect(pm.response.json().message).to.eql('Tài khoản đã bị vô hiệu hóa'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"test.disabled@example.com\",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Pending + sai mật khẩu → 401 chung (không lộ trạng thái)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('thông báo chung', () => pm.expect(pm.response.json().message).to.eql('Email hoặc mật khẩu không đúng'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"test.pending@example.com\",\"password\":\"WrongPass1\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Edge 2: sai 5 lần → lần 6 bị 429",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// Gửi trước 5 lần sai với email riêng của lần chạy này.",
              "const url = pm.collectionVariables.get('baseUrl') + '/auth/login';",
              "const body = JSON.stringify({ email: pm.collectionVariables.get('rlEmail'), password: 'WrongPass1' });",
              "const send = (n) => { if (n === 0) return; pm.sendRequest({ url, method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: body } }, (err, res) => { pm.expect(res.code).to.eql(401); send(n - 1); }); };",
              "send(5);"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('429 Too Many Requests', () => pm.response.to.have.status(429));",
              "pm.test('thông báo thử lại sau', () => pm.expect(pm.response.json().message).to.include('15 phút'));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"{{rlEmail}}\",\"password\":\"WrongPass1\"}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Validation",
      "item": [
        {
          "name": "Body rỗng → lỗi 2 field",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('đủ 2 field', () => pm.expect(pm.response.json().errors).to.have.all.keys('email', 'password'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Email sai định dạng → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('lỗi email', () => pm.expect(pm.response.json().errors.email).to.eql('Email không đúng định dạng'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"abc\",\"password\":\"{{password}}\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Mật khẩu 7 ký tự → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('lỗi tối thiểu 8', () => pm.expect(pm.response.json().errors.password).to.eql('Mật khẩu tối thiểu 8 ký tự'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"test.reader@example.com\",\"password\":\"1234567\"}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "Mật khẩu 17 ký tự → 400",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('lỗi tối đa 16', () => pm.expect(pm.response.json().errors.password).to.eql('Mật khẩu tối đa 16 ký tự'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"test.reader@example.com\",\"password\":\"aaaaaaaaaaaaaaaaa\"}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Phiên đăng nhập & quyền (GET /auth/me)",
      "item": [
        {
          "name": "Reader token → 200 role reader",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('role reader', () => pm.expect(pm.response.json().user.role).to.eql('reader'));"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{readerToken}}" }], "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Librarian token → 200 role librarian",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('role librarian', () => pm.expect(pm.response.json().user.role).to.eql('librarian'));"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{librarianToken}}" }], "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Admin token → 200 role admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('role admin', () => pm.expect(pm.response.json().user.role).to.eql('admin'));"
          ] } }],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Không có token → 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401', () => pm.response.to.have.status(401));",
            "pm.test('yêu cầu đăng nhập', () => pm.expect(pm.response.json().message).to.eql('Vui lòng đăng nhập'));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Token bị sửa (role admin, chữ ký cũ) → 401",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const [h, p, s] = pm.collectionVariables.get('readerToken').split('.');",
              "const payload = JSON.parse(atob(p.replace(/-/g, '+').replace(/_/g, '/')));",
              "payload.role = 'admin';",
              "const forged = btoa(JSON.stringify(payload)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "pm.collectionVariables.set('forgedToken', [h, forged, s].join('.'));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));",
              "pm.test('phiên hết hạn', () => pm.expect(pm.response.json().message).to.include('Phiên đăng nhập'));"
            ] } }
          ],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{forgedToken}}" }], "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Token alg none → 401",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "const b64 = (o) => btoa(JSON.stringify(o)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "pm.collectionVariables.set('noneToken', `${b64({ alg: 'none', typ: 'JWT' })}.${b64({ sub: '1', role: 'admin' })}.`);"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('401', () => pm.response.to.have.status(401));"
            ] } }
          ],
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{noneToken}}" }], "url": "{{baseUrl}}/auth/me" }
        }
      ]
    }
  ]
}
