                  "const titles = body.books.map((b) => b.title);",
                  "pm.test('pagination', () => pm.expect(body.pagination).to.eql({ page: 1, pageSize: 10, total: 12, totalPages: 2 }));",
                  "pm.test('DS 01 → DS 10', () => { pm.expect(titles[0]).to.eql('Test Sách DS 01'); pm.expect(titles[9]).to.eql('Test Sách DS 10'); });",
                  "pm.test('đủ trường', () => pm.expect(Object.keys(body.books[0]).sort()).to.eql(['author', 'availableQuantity', 'borrowedQuantity', 'category', 'coverUrl', 'id', 'publishYear', 'title']));",
                  "pm.test('thể loại đúng', () => body.books.forEach((b) => pm.expect(b.category.name).to.eql('Test Danh Sách')));",
                  "pm.test('chưa có ảnh → coverUrl null', () => pm.expect(body.books[0].coverUrl).to.eql(null));"
                ]
              }
