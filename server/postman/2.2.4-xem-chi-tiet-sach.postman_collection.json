                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const { book } = pm.response.json();",
                  "pm.test('thông tin PRD', () => { pm.expect(book.title).to.eql('Test Sách CT 01 Lịch Sử'); pm.expect(book.author).to.eql('Tác Giả CT'); pm.expect(book.isbn).to.eql('0306406152'); pm.expect(book.publishYear).to.eql(2015); pm.expect(book.description).to.eql('Dữ liệu test 2.2.4'); pm.expect(book.category.name).to.eql('Test Chi Tiết'); });",
                  "pm.test('số lượng có sẵn / đang mượn', () => { pm.expect(book.availableQuantity).to.eql(3); pm.expect(book.borrowedQuantity).to.eql(2); });",
                  "pm.test('edge 8: chưa có ảnh → coverUrl null', () => pm.expect(book.coverUrl).to.eql(null));",
                  "pm.test('edge 4: không trả lịch sử mượn', () => { pm.expect(pm.response.json()).to.have.all.keys('book'); pm.expect(pm.response.text()).to.not.include('@example.com'); });"
