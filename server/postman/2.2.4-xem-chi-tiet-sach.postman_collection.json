        {
          "name": "Librarian trang 1 → 10 dòng, mới nhất trước",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const { borrows, pagination } = pm.response.json();",
                  "pm.test('edge 6: phân trang 10/trang, 12 đơn', () => pm.expect(pagination).to.eql({ page: 1, pageSize: 10, total: 12, totalPages: 2 }));",
                  "pm.test('10 dòng', () => pm.expect(borrows).to.have.length(10));",
                  "pm.test('mới nhất trước: đơn chờ của test.reader', () => { pm.expect(borrows[0].status).to.eql('pending'); pm.expect(borrows[0].reader.email).to.eql('test.reader@example.com'); pm.expect(borrows[0].dueDate).to.eql(null); });",
                  "pm.test('thứ tự giảm dần theo ngày yêu cầu', () => { const t = borrows.map((b) => Date.parse(b.requestedAt)); pm.expect(t).to.eql([...t].sort((a, b) => b - a)); });",
                  "pm.test('có đủ trạng thái, quá hạn được suy ra', () => { const s = borrows.map((b) => b.status); ['pending', 'borrowing', 'overdue', 'returned', 'rejected'].forEach((x) => pm.expect(s).to.include(x)); });",
                  "pm.test('đơn quá hạn có hạn trả YYYY-MM-DD', () => { const o = borrows.find((b) => b.status === 'overdue'); pm.expect(o.reader.email).to.eql('test.overdue@example.com'); pm.expect(o.dueDate).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(o.borrowedAt).to.be.a('string'); });",
                  "pm.test('chỉ lộ id, tên, email độc giả', () => borrows.forEach((b) => pm.expect(b.reader).to.have.all.keys('id', 'name', 'email')));"
                ]
              }
            }
