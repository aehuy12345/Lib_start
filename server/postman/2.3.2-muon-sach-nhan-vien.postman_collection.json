        {
          "name": "Danh sách chờ: chỉ đơn pending, cũ nhất trước, 10/trang, lấy id đơn DM",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const { orders, pagination } = pm.response.json();",
                  "pm.test('phân trang 10/trang', () => { pm.expect(pagination.pageSize).to.eql(10); pm.expect(pagination.page).to.eql(1); pm.expect(orders.length).to.be.at.most(10); });",
                  "pm.test('cũ nhất trước', () => { const t = orders.map((o) => Date.parse(o.createdAt)); pm.expect(t).to.eql([...t].sort((a, b) => a - b)); });",
                  "const titles = {\"dm01\":\"Test Sách DM 01 API Xác Nhận\",\"dm02\":\"Test Sách DM 02 API Từ Chối\",\"dm03\":\"Test Sách DM 03 API Hết\",\"dm07\":\"Test Sách DM 07 Phạt\",\"dm08\":\"Test Sách DM 08 Vô Hiệu\",\"dm09\":\"Test Sách DM 09 Quá Hạn\"};",
                  "for (const [key, title] of Object.entries(titles)) {",
                  "  const o = orders.find((x) => x.book.title === title);",
                  "  pm.test(`có đơn ${title}`, () => pm.expect(o).to.be.an('object'));",
                  "  if (o) { pm.collectionVariables.set(`${key}Order`, o.id); pm.collectionVariables.set(`${key}Book`, o.book.id); }",
                  "}",
                  "const dm01 = orders.find((x) => x.book.title === titles.dm01);",
                  "pm.test('kèm độc giả, sách, SL có sẵn, thời hạn', () => { pm.expect(dm01.reader.email).to.eql('test.approvee@example.com'); pm.expect(dm01.book.availableQuantity).to.eql(2); pm.expect(dm01.requestedDays).to.eql(14); pm.expect(dm01.book.author).to.eql('Tác Giả DM'); });",
                  "pm.test('DM 03 hiện có sẵn 0 (edge 2)', () => pm.expect(orders.find((x) => x.book.title === titles.dm03).book.availableQuantity).to.eql(0));"
                ]
              }
            }
          ],
