        {
          "name": "Librarian xác nhận DM 01 → 200 Đang mượn, hạn trả = hôm nay (giờ VN) + 14",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const { message, order } = pm.response.json();",
                  "pm.test('message', () => pm.expect(message).to.eql('Đã xác nhận đơn mượn'));",
                  "pm.test('status borrowing', () => pm.expect(order.status).to.eql('borrowing'));",
                  "// Sandbox Postman không có Intl; Việt Nam cố định UTC+7.",
                  "const today = new Date(Date.now() + 7 * 3600 * 1000).toISOString().slice(0, 10);",
                  "const due = new Date(`${today}T00:00:00Z`); due.setUTCDate(due.getUTCDate() + 14);",
                  "pm.test('dueDate = hôm nay + 14', () => pm.expect(order.dueDate).to.eql(due.toISOString().slice(0, 10)));",
                  "pm.test('có borrowedAt', () => pm.expect(order.borrowedAt).to.be.a('string'));"
                ]
              }
            }
          ],
