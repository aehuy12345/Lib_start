    {
      "name": "Xem lịch sử",
      "item": [
        {
          "name": "Trang 1: 10 đơn mới nhất trước, 12 đơn (không tính đơn đã hủy), lấy id đơn LS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const vnToday = () => new Date(Date.now() + 7 * 3600 * 1000).toISOString().slice(0, 10);",
                  "const addDays = (d, n) => { const x = new Date(`${d}T00:00:00Z`); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); };",
                  "const { orders, pagination, today } = pm.response.json();",
                  "pm.test('phân trang 10/trang, 12 đơn, 2 trang', () => pm.expect(pagination).to.eql({ page: 1, pageSize: 10, total: 12, totalPages: 2 }));",
                  "pm.test('10 đơn trên trang 1', () => pm.expect(orders.length).to.eql(10));",
                  "pm.test('today theo giờ VN', () => pm.expect(today).to.eql(vnToday()));",
                  "pm.test('mới nhất trước', () => { const t = orders.map((o) => Date.parse(o.createdAt)); pm.expect(t).to.eql([...t].sort((a, b) => b - a)); });",
                  "pm.test('chỉ đơn LS của test.historian', () => orders.forEach((o) => pm.expect(o.book.title).to.match(/^Test Sách LS 0[1-7]/)));",
                  "const ls01 = orders.find((o) => o.book.title === 'Test Sách LS 01 Gia Hạn');",
                  "const ls02 = orders.find((o) => o.book.title === 'Test Sách LS 02 Đã Gia Hạn');",
                  "const ls03 = orders.find((o) => o.book.title === 'Test Sách LS 03 Quá Hạn');",
                  "const ls04 = orders.find((o) => o.book.title === 'Test Sách LS 04 Hôm Nay');",
                  "const ls05 = orders.find((o) => o.book.title === 'Test Sách LS 05 Chờ Trả');",
                  "const ls06 = orders.find((o) => o.book.title === 'Test Sách LS 06 Chờ Duyệt');",
                  "const ls07 = orders.find((o) => o.book.title === 'Test Sách LS 07 Đã Trả');",
                  "for (const [k, o] of Object.entries({ ls01, ls02, ls03, ls04, ls05, ls06, ls07 })) { pm.test(`có đơn ${k}`, () => pm.expect(o).to.be.an('object')); if (o) pm.collectionVariables.set(`${k}Order`, o.id); }",
                  "pm.collectionVariables.set('ls01Due', ls01.dueDate); pm.collectionVariables.set('ls01Book', ls01.book.id);",
                  "pm.test('Đang mượn: tên, tác giả, ngày mượn, hạn trả, số ngày còn lại', () => { pm.expect(ls01).to.include({ status: 'borrowing', dueDate: addDays(today, 5), daysLeft: 5, extensionCount: 0, canExtend: true, hasPendingReturn: false }); pm.expect(ls01.book.author).to.eql('Tác Giả LS'); pm.expect(ls01.borrowedAt).to.be.a('string'); });",
                  "pm.test('đã gia hạn 1 lần → không còn nút gia hạn', () => pm.expect(ls02).to.include({ status: 'borrowing', extensionCount: 1, canExtend: false }));",
                  "pm.test('Quá hạn suy ra từ hạn trả, số ngày âm', () => pm.expect(ls03).to.include({ status: 'overdue', daysLeft: -2, canExtend: false }));",
                  "pm.test('đúng ngày hạn vẫn Đang mượn và gia hạn được', () => pm.expect(ls04).to.include({ status: 'borrowing', dueDate: today, daysLeft: 0, canExtend: true }));",
                  "pm.test('có yêu cầu trả chờ → không gia hạn', () => pm.expect(ls05).to.include({ hasPendingReturn: true, canExtend: false }));",
                  "pm.test('Chờ xác nhận chưa có hạn trả', () => pm.expect(ls06).to.include({ status: 'pending', dueDate: null, daysLeft: null, canExtend: false }));",
                  "pm.test('Đã trả có ngày mượn và ngày trả', () => { pm.expect(ls07.status).to.eql('returned'); pm.expect(ls07.returnedAt).to.be.a('string'); pm.expect(ls07.borrowedAt).to.be.a('string'); pm.expect(ls07.daysLeft).to.eql(null); });"
                ]
              }
            }
          ],
