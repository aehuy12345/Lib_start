                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const vnToday = () => new Date(Date.now() + 7 * 3600 * 1000).toISOString().slice(0, 10);",
                  "const addDays = (d, n) => { const x = new Date(`${d}T00:00:00Z`); x.setUTCDate(x.getUTCDate() + n); return x.toISOString().slice(0, 10); };",
                  "const { orders } = pm.response.json();",
                  "const ls01 = orders.find((o) => o.book.title === 'Test Sách LS 01 Gia Hạn');",
                  "const ls04 = orders.find((o) => o.book.title === 'Test Sách LS 04 Hôm Nay');",
                  "pm.test('LS 01', () => pm.expect(ls01).to.include({ dueDate: addDays(pm.collectionVariables.get('ls01Due'), 7), extensionCount: 1, canExtend: false, daysLeft: 12 }));",
                  "pm.test('LS 04', () => pm.expect(ls04).to.include({ extensionCount: 1, canExtend: false, daysLeft: 7 }));",
                  "pm.test('không đơn nào còn gia hạn được', () => orders.forEach((o) => pm.expect(o.canExtend).to.eql(false)));"
                ]
              }
