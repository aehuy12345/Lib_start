        {
          "name": "Lịch sử test.returner: lấy id đơn TS, cờ Xin trả sách đúng từng đơn",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const find = (t) => pm.response.json().orders.find((o) => o.book.title === `Test Sách ${t}`);",
                  "['TS 01 Đang Mượn', 'TS 02 Quá Hạn', 'TS 03 Chờ Trả', 'TS 04 Đã Trả', 'TS 05 Chờ Duyệt'].forEach((t, i) => pm.collectionVariables.set(`ts0${i + 1}`, find(t).id));",
                  "pm.collectionVariables.set('ts03ReturnId', find('TS 03 Chờ Trả').pendingReturnId);",
                  "pm.test('TS 01 đang mượn → có nút', () => pm.expect(find('TS 01 Đang Mượn')).to.include({ status: 'borrowing', canRequestReturn: true, pendingReturnId: null }));",
                  "pm.test('Edge 2: TS 02 quá hạn → vẫn có nút', () => pm.expect(find('TS 02 Quá Hạn')).to.include({ status: 'overdue', canRequestReturn: true }));",
                  "pm.test('TS 03 đã có yêu cầu chờ → không có nút, có id để hủy', () => { const o = find('TS 03 Chờ Trả'); pm.expect(o).to.include({ hasPendingReturn: true, canRequestReturn: false }); pm.expect(o.pendingReturnId).to.be.a('number'); });",
                  "pm.test('Edge 3/7: TS 04 đã trả, TS 05 chờ duyệt → không có nút', () => { pm.expect(find('TS 04 Đã Trả').canRequestReturn).to.eql(false); pm.expect(find('TS 05 Chờ Duyệt').canRequestReturn).to.eql(false); });"
                ]
              }
            }
          ],
