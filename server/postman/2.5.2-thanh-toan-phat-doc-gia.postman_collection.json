    {
      "name": "Xem danh sách",
      "item": [
        {
          "name": "Mặc định: phiếu cần thanh toán (Chưa thanh toán + Từ chối)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('3 phiếu, mới nhất trước', () => { pm.expect(b.tickets.map((t) => t.status)).to.eql(['unpaid', 'unpaid', 'rejected']); });",
                  "pm.test('tổng cần thanh toán 180.000, 1 phiếu chờ', () => pm.expect(b.summary).to.eql({ dueCount: 3, dueAmount: 180000, pendingCount: 1 }));",
                  "pm.test('có thông tin ngân hàng', () => pm.expect(b.bank.accountNumber).to.be.a('string'));",
                  "pm.test('phân trang', () => pm.expect(b.pagination).to.eql({ page: 1, pageSize: 10, total: 3, totalPages: 1 }));",
                  "const [a, bt, c] = b.tickets;",
                  "pm.test('đủ cột: nguyên nhân, số tiền, ngày phạt, trạng thái', () => { pm.expect(a).to.include({ type: 'late', tierName: 'Test TT Trả Muộn', amount: 10000, bookTitle: 'Test Sách TT 01 Thanh Toán', canPay: true, hasReceipt: false }); pm.expect(a.issuedAt).to.be.a('string'); });",
                  "pm.test('edge 5: nội dung chuyển khoản chứa mã phiếu', () => pm.expect(a.transferContent).to.eql('THU VIEN PHAT ' + a.id));",
                  "pm.test('edge 2: phiếu từ chối kèm lý do, được thanh toán lại', () => pm.expect(c).to.include({ type: 'lost', rejectReason: 'Chưa nhận được tiền chuyển khoản', canPay: true }));",
                  "pm.test('ghi chú của phiếu hư hỏng', () => pm.expect(bt.note).to.eql('Rách bìa (test 2.5.2)'));",
                  "pm.collectionVariables.set('ticketA', a.id); pm.collectionVariables.set('ticketB', bt.id); pm.collectionVariables.set('ticketC', c.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
