    {
      "name": "Chuẩn bị",
      "item": [
        {
          "name": "danh sách \"test.ur.api\" → 3 tài khoản, có số đơn/phiếu phạt để cảnh báo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?q=test.ur.api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "test.ur.api"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const users = pm.response.json().users;",
                  "const by = (e) => users.find((u) => u.email === e);",
                  "const reader = by('test.ur.api.reader@example.com');",
                  "const lib = by('test.ur.api.librarian@example.com');",
                  "const dis = by('test.ur.api.disabled@example.com');",
                  "pm.test('3 tài khoản', () => pm.expect(users).to.have.length(3));",
                  "pm.test('reader: đang mượn 1, chờ duyệt 1, không có phạt', () => {",
                  "  pm.expect(reader).to.include({ role: 'reader', status: 'active', activeBorrowCount: 1, pendingBorrowCount: 1, unpaidFineCount: 0 });",
                  "});",
                  "pm.test('đổi được vai trò người khác', () => users.forEach((u) => pm.expect(u.canChangeRole).to.eql(true)));",
                  "pm.test('disabled là độc giả bị khóa', () => pm.expect(dis).to.include({ role: 'reader', status: 'disabled' }));",
                  "pm.collectionVariables.set('readerUid', reader.id);",
                  "pm.collectionVariables.set('librarianUid', lib.id);",
                  "pm.collectionVariables.set('disabledUid', dis.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "tài khoản của chính mình: canChangeRole false",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users?q=test.admin%40example.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "test.admin%40example.com"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const me = pm.response.json().users.find((u) => u.email === 'test.admin@example.com');",
                  "pm.test('isSelf, không đổi được vai trò', () => pm.expect(me).to.include({ isSelf: true, canChangeRole: false }));",
                  "pm.collectionVariables.set('selfId', me.id);"
                ]
              }
            }
          ]
        }
