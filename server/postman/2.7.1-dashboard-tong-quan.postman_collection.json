                  "pm.test('edge 5: không cache', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "const body = pm.response.json();",
                  "pm.test('có titleCount', () => pm.expect(body).to.have.property('titleCount'));"
                ]
