    {
      "name": "Librarian",
      "item": [
        {
          "name": "Tổng số sách",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('edge 5: không cache', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "const body = pm.response.json();",
                  "const isCount = (v) => Number.isInteger(v) && v >= 0;",
                  "pm.test('đủ chỉ số, số nguyên ≥ 0', () => ['titleCount', 'totalQuantity', 'available', 'borrowed', 'lost', 'damaged'].forEach((k) => pm.expect(isCount(body[k]), k).to.be.true));",
                  "pm.test('có sẵn + đang mượn ≤ tổng số cuốn', () => pm.expect(body.available + body.borrowed).to.be.at.most(body.totalQuantity));",
                  "pm.test('seed có sách DB 01 và DB 03 đang mượn', () => pm.expect(body.borrowed).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tổng số độc giả",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/readers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "readers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('edge 5: không cache', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "const body = pm.response.json();",
                  "pm.test('chỉ hoạt động / vô hiệu hóa', () => pm.expect(Object.keys(body).sort()).to.eql(['active', 'disabled']));",
                  "pm.test('seed có độc giả hoạt động và bị khóa', () => { pm.expect(body.active).to.be.above(0); pm.expect(body.disabled).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Đơn mượn hôm nay",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/borrows-today",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "borrows-today"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('edge 5: không cache', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "const body = pm.response.json();",
                  "const today = new Date(Date.now() + 7 * 3600 * 1000).toISOString().slice(0, 10);",
                  "pm.test('edge 4: ngày theo giờ Việt Nam', () => pm.expect(body.date).to.eql(today));",
                  "pm.test('tổng = cộng các trạng thái', () => pm.expect(Object.values(body.byStatus).reduce((a, b) => a + b, 0)).to.eql(body.total));",
                  "pm.test('đơn chờ DB 04 tạo hôm nay được đếm', () => pm.expect(body.byStatus.pending).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Top 5 sách phổ biến",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/top-books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "top-books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('edge 5: không cache', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "const body = pm.response.json();",
                  "pm.test('tối đa 5, giảm dần theo lượt mượn', () => { pm.expect(body.books.length).to.be.within(1, 5); body.books.slice(1).forEach((b, i) => pm.expect(b.borrowCount).to.be.at.most(body.books[i].borrowCount)); });",
                  "pm.test('DB 01 đứng đầu', () => pm.expect(body.books[0]).to.include({ title: 'Test Sách DB 01 Phổ Biến', borrowCount: 9999, deleted: false }));",
                  "pm.test('edge 7: sách đã xóa vẫn tính vào thống kê mượn', () => pm.expect(body.books[1]).to.include({ title: 'Test Sách DB 02 Đã Xóa', deleted: true }));"
                ]
              }
            }
          ]
        }
