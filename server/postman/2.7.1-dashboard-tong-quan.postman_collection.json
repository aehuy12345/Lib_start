    {
      "name": "Admin",
      "item": [
        {
          "name": "Độc giả nợ quá hạn",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/overdue-readers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard",
                "overdue-readers"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('edge 5: không cache', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
                  "const body = pm.response.json();",
                  "pm.test('edge 3: tối đa 10 dòng kèm tổng', () => { pm.expect(body.limit).to.eql(10); pm.expect(body.readers.length).to.be.at.most(10); pm.expect(body.total).to.be.at.least(body.readers.length); });",
                  "const first = body.readers[0];",
                  "pm.test('test.dashboard muộn lâu nhất đứng đầu', () => pm.expect(first).to.include({ email: 'test.dashboard@example.com', maxLateDays: 45 }));",
                  "pm.test('kèm sách và số ngày muộn', () => pm.expect(first.books.map((b) => [b.title, b.lateDays])).to.eql([['Test Sách DB 01 Phổ Biến', 45], ['Test Sách DB 03 Quá Hạn', 40]]));",
                  "pm.test('sắp theo số ngày muộn giảm dần', () => body.readers.slice(1).forEach((r, i) => pm.expect(r.maxLateDays).to.be.at.most(body.readers[i].maxLateDays)));",
                  "pm.test('mọi sách đều đã quá hạn', () => body.readers.forEach((r) => r.books.forEach((b) => pm.expect(b.lateDays).to.be.above(0))));"
                ]
              }
            }
          ]
        },
