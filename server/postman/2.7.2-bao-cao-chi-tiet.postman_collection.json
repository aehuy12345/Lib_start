        {
          "name": "Báo cáo Sách quý 1/2020",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/books?from=2020-01-01&to=2020-03-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "books"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2020-01-01"
                },
                {
                  "key": "to",
                  "value": "2020-03-31"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('lượt mượn, mất, hư trong kỳ', () => pm.expect([body.summary.borrowsInRange, body.summary.lostInRange, body.summary.damagedInRange]).to.eql([7, 1, 1]));",
                  "pm.test('sắp theo lượt mượn trong kỳ, bằng nhau theo tên', () => pm.expect(body.rows.slice(0, 3).map((r) => [r.title, r.borrowsInRange])).to.eql([['Test Sách BC 01 Mượn Nhiều', 3], ['Test Sách BC 02 Mất Hư', 2], ['Test Sách BC 03 \"Nháy\", Phẩy', 2]]));",
                  "pm.test('tồn kho hiện tại của BC 02', () => pm.expect(body.rows[1]).to.include({ totalQuantity: 3, available: 2, damaged: 1, lostInRange: 1, damagedInRange: 1 }));",
                  "pm.test('biểu đồ top sách', () => pm.expect(body.chart.map((c) => c.borrows)).to.eql([3, 2, 2]));",
                  "pm.test('10 dòng mỗi trang, có dữ liệu', () => { pm.expect(body.pagination.pageSize).to.eql(10); pm.expect(body.rows.length).to.be.at.most(10); pm.expect(body.hasData).to.eql(true); });"
                ]
              }
            }
          ]
        },
